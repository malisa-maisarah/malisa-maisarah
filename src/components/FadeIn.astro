---
interface Props {
  delay?: number;
  direction?: "up" | "down" | "left" | "right";
  className?: string;
}

const { delay = 0, direction = "up", className = "" } = Astro.props;
---

<div
  class:list={["fade-in", `fade-in--${direction}`, className]}
  style={`--fade-delay: ${delay}s`}
>
  <slot />
</div>
