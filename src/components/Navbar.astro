---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-[#FAF9F6]/80 backdrop-blur-md border-b border-slate-200/60"
>
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="font-bold text-lg tracking-tight text-slate-900">
      Malisa <span class="text-brand-600 font-normal">/ Social Work</span>
    </a>

    <nav class="hidden md:flex space-x-8 text-sm font-medium text-slate-600">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "hover:text-brand-600 transition-colors",
            { "text-brand-600": currentPath === link.href },
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-slate-700"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu md:hidden border-t border-slate-200/60 bg-[#FAF9F6]/95 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-6 py-4 space-y-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "block text-sm font-medium text-slate-600 hover:text-brand-600 transition-colors",
            { "text-brand-600": currentPath === link.href },
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    btn?.addEventListener("click", () => {
      menu?.classList.toggle("is-open");
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
</script>
