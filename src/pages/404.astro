---
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
---

<BaseLayout
  title="Page Not Found | Malisa Maisarah"
  description="The page you are looking for could not be found."
>
  <section class="max-w-6xl mx-auto px-6 py-24 md:py-32 text-center">
    <FadeIn>
      <span
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-100/70 text-brand-800 text-xs font-semibold tracking-wide mb-6"
      >
        404 Error
      </span>
    </FadeIn>
    <FadeIn delay={0.1}>
      <h1 class="text-6xl md:text-8xl font-bold tracking-tight text-slate-900">
        Page Not Found
      </h1>
    </FadeIn>
    <FadeIn delay={0.2}>
      <p class="text-lg text-slate-600 font-light max-w-xl mx-auto mt-6 leading-relaxed">
        The page you are looking for does not exist or may have been moved.
        Let's get you back on track.
      </p>
    </FadeIn>
    <FadeIn delay={0.3}>
      <div class="pt-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-brand-600 text-white font-medium hover:bg-brand-700 shadow-lg shadow-brand-600/20 transition-all"
        >
          Back to Home
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </FadeIn>
  </section>
</BaseLayout>
