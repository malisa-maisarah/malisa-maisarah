---
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
---

<BaseLayout
  title="Contact | Malisa Maisarah"
  description="Contact Malisa Maisarah for consultation and collaboration."
>
  <!-- Impact -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <FadeIn>
        <span
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-100/70 text-brand-800 text-xs font-semibold tracking-wide mb-6"
        >
          Impact
        </span>
      </FadeIn>
      <FadeIn delay={0.1}>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">
          Achievements & Impact
        </h2>
      </FadeIn>
    </div>

    <FadeIn delay={0.2}>
      <div class="bg-brand-50 border border-brand-200/60 rounded-3xl p-8 flex flex-col md:flex-row items-center gap-6 max-w-4xl mx-auto">
        <div class="w-14 h-14 rounded-2xl bg-brand-500 flex items-center justify-center text-white shrink-0">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
        </div>
        <div class="text-center md:text-left">
          <h3 class="text-lg font-bold text-slate-900">Best Community Program Award 2024</h3>
          <p class="text-sm text-slate-600 mt-1 font-light">
            Recognition for contributions to community welfare programmes throughout university.
          </p>
        </div>
      </div>
    </FadeIn>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="max-w-6xl mx-auto px-6 py-20">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <FadeIn>
        <span
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-100/70 text-brand-800 text-xs font-semibold tracking-wide mb-6"
        >
          Get in Touch
        </span>
      </FadeIn>
      <FadeIn delay={0.1}>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-6">
          Let's Connect
        </h2>
      </FadeIn>
      <FadeIn delay={0.2}>
        <p class="text-slate-600 font-light leading-relaxed">
          Whether you need personal consultation, programme collaboration,
          or career opportunities, don't hesitate to reach out.
        </p>
      </FadeIn>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto">
      <FadeIn delay={0.25}>
        <a href="mailto:malisamaisarah02@gmail.com" class="flex items-center gap-4 p-5 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow group">
          <div class="w-11 h-11 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 group-hover:bg-brand-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-medium">Email</p>
            <p class="text-sm text-slate-800 font-medium">malisamaisarah02@gmail.com</p>
          </div>
        </a>
      </FadeIn>

      <FadeIn delay={0.3}>
        <a href="tel:01111434833" class="flex items-center gap-4 p-5 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow group">
          <div class="w-11 h-11 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 group-hover:bg-brand-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-medium">Phone</p>
            <p class="text-sm text-slate-800 font-medium">Let's Talk</p>
          </div>
        </a>
      </FadeIn>

      <FadeIn delay={0.35}>
        <a href="https://linkedin.com/in/malisa-maisarah" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow group">
          <div class="w-11 h-11 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 group-hover:bg-brand-100 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-medium">LinkedIn</p>
            <p class="text-sm text-slate-800 font-medium">linkedin.com/in/malisa-maisarah</p>
          </div>
        </a>
      </FadeIn>

      <FadeIn delay={0.4}>
        <div class="flex items-center gap-4 p-5 bg-white rounded-2xl border border-slate-200/80 shadow-sm">
          <div class="w-11 h-11 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-medium">Location</p>
            <p class="text-sm text-slate-800 font-medium">Federal Territory, Putrajaya</p>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>
</BaseLayout>
