---
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
---

<BaseLayout
  title="Services | Malisa Maisarah"
  description="Areas of expertise and social work services by Malisa Maisarah."
>
  <section class="max-w-6xl mx-auto px-6 py-20">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <FadeIn>
        <span
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-100/70 text-brand-800 text-xs font-semibold tracking-wide mb-6"
        >
          Services
        </span>
      </FadeIn>
      <FadeIn delay={0.1}>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">
          Areas of Expertise & Experience
        </h2>
      </FadeIn>
      <FadeIn delay={0.2}>
        <p class="text-slate-600 mt-3 font-light">
          Practical experience in social work, community programme coordination, and administration.
        </p>
      </FadeIn>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Row 1: Large Card (2col) + Dark Card (1col) -->
      <FadeIn delay={0.1} className="md:col-span-2 h-full">
        <div
          class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between h-full"
        >
          <div>
            <div
              class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-600 mb-6"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900">
              Psychosocial Assessment & Support
            </h3>
            <p class="text-slate-600 mt-3 font-light leading-relaxed">
              Internship at Hospital Sultan Abdul Aziz Shah (HSAAS), UPM.
              Conducted 50+ psychosocial assessments and patient interviews,
              as well as coordinating 10+ patient placements to care homes
              and rehabilitation centres.
            </p>
          </div>
          <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between text-sm font-semibold text-brand-600">
            <span>Mar – Jul 2025</span>
            <span>HSAAS, UPM</span>
          </div>
        </div>
      </FadeIn>

      <FadeIn delay={0.2} className="h-full">
        <div
          class="bg-brand-900 text-white p-8 rounded-3xl shadow-sm flex flex-col justify-between h-full"
        >
          <div>
            <div
              class="w-12 h-12 rounded-2xl bg-brand-800/60 flex items-center justify-center text-brand-300 mb-6"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold">Community Programme Coordination</h3>
            <p class="text-brand-100/80 mt-3 font-light text-sm leading-relaxed">
              Anti-Drugs Programme 2023, Gerontology Programme 2024,
              Sentuhan Kasih Jalinan Komuniti Programme 2024, and
              Children's Day Celebration 2024.
            </p>
          </div>
        </div>
      </FadeIn>

      <!-- Row 2: Two medium cards (1col each) -->
      <FadeIn delay={0.15} className="h-full">
        <div
          class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow h-full"
        >
          <div
            class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-600 mb-6"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Documentation & Administration
          </h3>
          <p class="text-slate-600 mt-3 font-light text-sm leading-relaxed">
            Administrative Assistant (MySTEP) at the Office of the Chief Registrar,
            Federal Court, Putrajaya. Record management, data entry,
            and inter-department coordination.
          </p>
        </div>
      </FadeIn>

      <FadeIn delay={0.25} className="h-full">
        <div
          class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow h-full"
        >
          <div
            class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-600 mb-6"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Secretariat & Activities
          </h3>
          <p class="text-slate-600 mt-3 font-light text-sm leading-relaxed">
            HSAAS Welfare Project Secretariat — Appreciation Day Flower Sales
            Project 2025. Social Science Tour: Towards Forming A Unity 2024.
          </p>
        </div>
      </FadeIn>

      <FadeIn delay={0.3} className="h-full">
        <div
          class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow h-full"
        >
          <div
            class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-600 mb-6"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Community Collaboration
          </h3>
          <p class="text-slate-600 mt-3 font-light text-sm leading-relaxed">
            Collaboration with Pondok Remaja Inabah 2, Pusat Jagaan Sinar Insan
            Marang, Felda Kampung Chalok Barat, and Tadika Genius Khaliph
            for welfare and community awareness programmes.
          </p>
        </div>
      </FadeIn>

      <!-- Row 3: Wide card (2col) -->
      <FadeIn delay={0.2} className="md:col-span-3 h-full">
        <div
          class="bg-slate-100 p-8 rounded-3xl border border-slate-200/60 shadow-sm flex flex-col md:flex-row gap-6 items-center h-full"
        >
          <div class="space-y-3">
            <h3 class="text-xl font-bold text-slate-900">
              Other Community Programmes
            </h3>
            <p class="text-slate-600 font-light text-sm leading-relaxed">
              Social Science Tour: Towards Forming A Unity 2024, in collaboration with
              Felda Kampung Chalok Barat, Tadika Genius Khaliph, and Pusat Jagaan
              Sinar Insan Marang.
            </p>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>
</BaseLayout>
